#!/usr/bin/env bash
# pre-push — 增量 typecheck/lint/test（最小证据），hooks 只做快检查，CI 拥有穷尽矩阵
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

echo "== pre-push: 增量检查 =="

# 变更范围（供人确认）
if [[ -x scripts/change-scope.sh ]]; then
  scripts/change-scope.sh || true
  echo
fi

# 仅当 src/** 或 test/** 有变更时才跑 TS 工程链；否则跳过以省时（CI 仍会全量矩阵）
CHANGED="$(git diff --name-only HEAD 2>/dev/null || true; git diff --cached --name-only 2>/dev/null || true)"
if echo "$CHANGED" | grep -qE "^(src|test)/"; then
  echo "-> pnpm typecheck"
  pnpm typecheck
  echo "-> pnpm lint"
  pnpm lint
  echo "-> pnpm test"
  pnpm test
else
  echo "src/test 无变更，跳过 typecheck/lint/test（CI 仍会全量）"
fi

# 文档门禁（增量也跑，防推坏链接）
echo "-> 文档门禁"
python3 scripts/verify-adr-format.py
python3 scripts/verify-doc-budgets.py --manifest scripts/doc-budgets.manifest.json
python3 scripts/verify-md-links.py

echo "pre-push OK"
